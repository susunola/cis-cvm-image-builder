# 复制本文件为 variables.pkrvars.hcl 后填写，勿提交含真实值的文件
# （AK/SK 走环境变量 TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY，不在此填）

region            = "ap-guangzhou"
zone              = "ap-guangzhou-4"
instance_type     = "S5.MEDIUM2"

# 官方 Ubuntu 22.04 公共镜像 ID（控制台镜像页或 tccli DescribeImages 获取）
source_image_id   = "img-xxxxxxxx"

# 专用构建 VPC / 子网 / 安全组（SG 放行 22 入站，来源限定构建机出口 IP）
vpc_id            = "vpc-xxxxxxxx"
subnet_id         = "subnet-xxxxxxxx"
security_group_id = "sg-xxxxxxxx"

# 可选：跨地域自动复制
image_copy_regions = ["ap-shanghai"]

# CIS 等级 / 审计容忍失败数
cis_level         = "level1-server"
cis_max_failures  = 0
