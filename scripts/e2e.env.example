# Copy this file to scripts/e2e.env (gitignored) and fill in real values,
# then run:
#
#   source scripts/e2e.env
#   python3 scripts/real_e2e_test.py \
#       --region "$E2E_REGION" --zone "$E2E_ZONE" \
#       --vpc-id "$E2E_VPC_ID" --subnet-id "$E2E_SUBNET_ID" \
#       --security-group-id "$E2E_SG_ID" --yes
#
# Never commit scripts/e2e.env — it holds live Tencent Cloud credentials.

# --- Tencent Cloud API credentials (read directly by ohbs_image._tc3_api) ---
# example: AKID************************abcd
export TENCENTCLOUD_SECRET_ID=

# example: 3f8a9c2e1b7d4f6a0e5c8b1a9d2f7e4c
export TENCENTCLOUD_SECRET_KEY=

# Only needed if using temporary STS credentials; leave blank otherwise.
# example: STOKEN********************************
export TENCENTCLOUD_SECURITY_TOKEN=

# --- Region/zone placement — REQUIRED, no default ---
# Must match the region/zone your VPC/subnet/security group/image below
# actually live in. Mismatches here surface as a confusing
# "security group id is `None`" error from the CVM API, not a clear
# "wrong region" message — always double check with DescribeZones /
# DescribeSubnets / DescribeImages if unsure.

# example: ap-guangzhou / ap-shanghai / ap-hongkong
E2E_REGION=

# example: ap-guangzhou-3 (must be a zone within E2E_REGION)
E2E_ZONE=

# --- Network placement for the throwaway CVM (must pre-exist, same region) ---
# The security group MUST already allow inbound TCP/22 from this machine's
# public IP — real_e2e_test.py does not modify security group rules.

# example: vpc-a1b2c3d4
E2E_VPC_ID=

# example: subnet-a1b2c3d4
E2E_SUBNET_ID=

# example: sg-a1b2c3d4
E2E_SG_ID=

# --- Optional overrides (defaults match scripts/real_e2e_test.py) ---
# Custom images do not auto-replicate across regions — confirm E2E_IMAGE_ID
# actually exists in E2E_REGION before relying on the default.
# E2E_IMAGE_ID=img-31d8ynuj
# E2E_INSTANCE_TYPE=SA5.MEDIUM2
# E2E_BRANCH=main

# --- Per-profile TARGET images for --target-mode single/all-linux/all ---
# There are TWO kinds of machine here:
#   * the JUMP box (编译机) — the AlmaLinux CVM configured by E2E_IMAGE_ID /
#     E2E_REGION / E2E_VPC_ID / ... above. It runs the test suite and
#     drives the builds.
#   * each profile's TARGET build CVM (目标机器) — the machine that actually
#     gets hardened by `ohbs-image build`, configured per-profile below.
# Each profile needs its OWN TARGET image ID (rhel8 needs a RHEL 8 image,
# win2022 needs a Windows Server 2022 image, etc.) — these are UNRELATED to
# E2E_IMAGE_ID above (which is only the jump box). All are optional and only
# read locally by real_e2e_test.py to decide which profile+level
# combinations to build.
#
# In --target-mode single, a missing image for the chosen --profile is a
# hard error. In --target-mode all-linux/all, any profile left unset here is
# silently skipped and shown as "skipped: no image configured" in the HTML
# report — the rest of the batch still runs.
# E2E_TARGET_IMAGE_UBUNTU2004=img-xxxxxxxx
# E2E_TARGET_IMAGE_UBUNTU2204=img-xxxxxxxx
# E2E_TARGET_IMAGE_UBUNTU2404=img-xxxxxxxx
# E2E_TARGET_IMAGE_RHEL8=img-xxxxxxxx
# E2E_TARGET_IMAGE_RHEL9=img-xxxxxxxx
# E2E_TARGET_IMAGE_RHEL10=img-xxxxxxxx
# E2E_TARGET_IMAGE_TENCENTOS3=img-xxxxxxxx
# E2E_TARGET_IMAGE_TENCENTOS4=img-xxxxxxxx
# E2E_TARGET_IMAGE_WIN2016=img-xxxxxxxx
# E2E_TARGET_IMAGE_WIN2019=img-xxxxxxxx
# E2E_TARGET_IMAGE_WIN2022=img-xxxxxxxx

# --- Optional TARGET placement (UNIFORM for all profiles, for
# --target-mode single/all-linux/all) ---
# ALL profile TARGET build CVMs share the SAME placement below. By default
# (any of these unset) they reuse the JUMP box's --region/--zone/--vpc-id/
# --subnet-id/--security-group-id. Set any field here to point every target
# build CVM at a different region / VPC (e.g. when the target images only
# exist in another region) — unset fields still fall back to the jump box's
# value. Only the target IMAGE is per-profile (E2E_TARGET_IMAGE_<PROFILE>).
#   E2E_TARGET_REGION=ap-hongkong
#   E2E_TARGET_ZONE=ap-hongkong-2
#   E2E_TARGET_VPC_ID=vpc-xxxxxxxx
#   E2E_TARGET_SUBNET_ID=subnet-xxxxxxxx
#   E2E_TARGET_SG_ID=sg-xxxxxxxx
# Example — build every profile's TARGET in Hong Kong while the jump box
# stays in Guangzhou:
#   E2E_TARGET_IMAGE_RHEL8=img-rhel8-hk
#   E2E_TARGET_IMAGE_WIN2022=img-win2022-hk
#   E2E_TARGET_REGION=ap-hongkong
#   E2E_TARGET_ZONE=ap-hongkong-2
#   E2E_TARGET_VPC_ID=vpc-hongkong-1
#   E2E_TARGET_SUBNET_ID=subnet-hongkong-1
#   E2E_TARGET_SG_ID=sg-hongkong-1
# E2E_TARGET_IMAGE_WIN2025=img-xxxxxxxx

# Required only if any Windows profile is in scope (single --profile
# winXXXX, or --target-mode all). Forwarded into the jump box's environment
# so the nested `ohbs-image build` can authenticate WinRM on that profile's
# own temporary build CVM.
# export WINRM_PASSWORD=

# --- Optional matrix-mode controls (all-linux / all) ---
# Which CIS Level(s) to build for each profile. One of '1', '2', or 'both'
# (same as --levels). Default 'both'. Only meaningful for the batch modes;
# --target-mode single uses --level instead.
# E2E_LEVELS=both

# Max concurrent `ohbs-image build` subprocesses on the jump box (same as
# --max-parallel-builds). Default 4 when unset. Only meaningful for the
# batch modes.
# E2E_MAX_PARALLEL_BUILDS=4

# Target build CVM instance type(s), tried in order. The primary is the
# default SA5.MEDIUM2 (or --build-instance-type); if it fails with
# ResourceInsufficient (understocked), the fallbacks S6.MEDIUM2 / SA2.MEDIUM2
# are tried automatically. Set a comma-separated list here to override the
# whole candidate list:
# E2E_BUILD_INSTANCE_TYPES=SA5.MEDIUM2,S6.MEDIUM2,SA2.MEDIUM2
#
# Note: SA-series instance types (SA5/SA2) do NOT support the default
# CLOUD_PREMIUM root disk, so the runner auto-sets disk_type=CLOUD_SSD for
# them via ohbs-image's [build.packer] passthrough. Non-SA types (S5/S6) use
# the plugin default (CLOUD_PREMIUM).

# --- Networking note for --target-mode single/all-linux/all ---
# Each profile+level build launches its own temporary TARGET build CVM WITH
# a PUBLIC IP (associate_public_ip=true), reached from the jump box over the
# PUBLIC internet — the jump box and the targets may live in DIFFERENT
# regions/VPCs where no private routing exists (e.g. jump box in ap-hongkong,
# targets in ap-guangzhou). All target build CVMs share the placement set by
# E2E_TARGET_REGION/ZONE/VPC_ID/SUBNET_ID/SG_ID above, or fall back to the
# jump box's own region/VPC/subnet.
#
# The target security group must allow inbound TCP/22 (Linux builds) and
# TCP/5986 (Windows builds) from the jump box's PUBLIC IP — real_e2e_test.py
# does not modify security group rules, same as for the jump box's own
# inbound TCP/22 rule above.
