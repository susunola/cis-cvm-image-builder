        "Supports Windows Server 2019 / 2022 / 2025"
      ]
    },
    {
      "dot": "cyan",
      "title": "Supported Profiles",
      "items": [
        "Linux: ubuntu22, ubuntu24, rhel8, rhel9, centos8, centos9",
