{#- Fleet overview across every host in the play. Language switchable.
    v2 — professional enterprise layout matching report template. -#}
{%- macro L(zh, en) -%}{{ en }}{%- endmacro -%}
{%- set hosts = [] -%}
{%- for h in ansible_play_hosts | sort -%}
  {%- if hostvars[h].cis_result is defined -%}{%- set _ = hosts.append(hostvars[h]) -%}{%- endif -%}
{%- endfor -%}
{%- set tot = {'rules': 0, 'pass': 0, 'fail': 0, 'manual': 0, 'error': 0,
               'l1applied': 0, 'l2applied': 0, 'pending': 0, 'failedfix': 0} -%}
{%- for hv in hosts -%}
  {%- set s = hv.cis_result.summary -%}
  {%- set _ = tot.update({
        'rules':  tot['rules']  + (s.all.total | int),
        'pass':   tot['pass']   + (s.all['pass'] | int),
        'fail':   tot['fail']   + (s.all.fail | int),
        'manual': tot['manual'] + (s.all.manual | int),
        'error':  tot['error']  + (s.all.error | int),
        'l1applied': tot['l1applied'] + (s.L1.applied | int) + (s.L1.applied_pending | int),
        'l2applied': tot['l2applied'] + (s.L2.applied | int) + (s.L2.applied_pending | int),
        'pending':   tot['pending']   + (s.all.applied_pending | int),
        'failedfix': tot['failedfix'] + (s.all.apply_failed | default(0) | int)}) -%}
{%- endfor -%}
{%- set scored = tot['pass'] + tot['fail'] -%}
{%- set fleetscore = (100.0 * tot['pass'] / scored) | round(1) if scored else 0.0 -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cis_benchmark_name }} {{ cis_benchmark_version }} · {{ 'Fleet Compliance Overview' }}</title>
<style>
:root{
  --bg:#f0f2f8;--card:#fff;--ink:#1a2332;--ink2:#4a5f7a;--ink3:#8896aa;
  --line:#e1e6ef;--line2:#eef1f7;--brand:#1e3a6e;--brand2:#3b6fd9;
  --ok:#0d7a53;--okbg:#eaf6f1;--okln:#a8d9bf;
  --bad:#c42a1e;--badbg:#fdf1f0;--badln:#f0bfb9;
  --warn:#b86c00;--warnbg:#fef8eb;--warnln:#f5d98f;
  --na:#64748b;--nabg:#eef1f6;--naln:#d0d8e2;
  --shadow-sm:0 1px 3px rgba(15,23,42,.04);
  --shadow-md:0 4px 16px rgba(15,23,42,.06);
  --radius-sm:8px;
  --radius-md:12px;
  --radius-lg:18px;
  --font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",
    "Hiragino Sans GB","Microsoft YaHei",Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font:14px/1.65 var(--font-sans);
  font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
code,.mono{font-family:var(--font-mono)}
a{color:var(--brand2);text-decoration:none;font-weight:600;border-bottom:1.5px solid transparent;
  transition:border-color .15s}
a:hover{border-bottom-color:var(--brand2)}
/* ── masthead ── */
.mast{background:linear-gradient(135deg,#122240 0%,#1a3560 40%,#1e4580 100%);
  color:#fff;position:relative;overflow:hidden}
.mast::before{
  content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;
  background:radial-gradient(circle,rgba(59,111,217,.12) 0,transparent 70%);
  pointer-events:none}
.mast-in{max-width:1200px;margin:0 auto;padding:32px 28px 38px;
  display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;justify-content:space-between;
  position:relative;z-index:1}
.mast h1{margin:0;font-size:22px;font-weight:700;letter-spacing:.3px;line-height:1.3}
.mast .sub{margin-top:8px;font-size:13px;color:#b8c4e0;line-height:1.6}
.mbadges{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.mb{display:inline-flex;align-items:center;padding:5px 12px;border-radius:999px;
  font-size:11.5px;font-weight:600;background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.16)}
.wrap{max-width:1200px;margin:0 auto;padding:0 28px 64px}

/* ── stat cards ── */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(176px,1fr));gap:14px;
  margin-top:-20px;position:relative;z-index:2}
.st{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-md);
  padding:20px 22px;box-shadow:var(--shadow-md);transition:box-shadow .2s,
  transform .15s}
.st:hover{box-shadow:var(--shadow-md);transform:translateY(-1px)}
.st .k{font-size:10.5px;color:var(--ink3);letter-spacing:.8px;text-transform:uppercase;
  font-weight:750;margin-bottom:8px;display:block}
.st .v{font-size:32px;font-weight:800;line-height:1.2;letter-spacing:-1px}
.st .u{font-size:11.5px;color:var(--ink3);margin-top:4px;display:block}

/* ── section heading ── */
h2.sec{font-size:15.5px;font-weight:700;margin:36px 0 16px;color:var(--ink);
  display:flex;align-items:center;gap:10px}
h2.sec::before{content:"";width:4px;height:18px;background:linear-gradient(180deg,var(--brand2),#60a5fa);
  border-radius:3px}

/* ── host table ── */
.tblwrap{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-md);
  box-shadow:var(--shadow-sm);overflow:auto}
table{width:100%;border-collapse:separate;border-spacing:0;min-width:960px}
thead th{text-align:left;font-size:10.5px;letter-spacing:.7px;text-transform:uppercase;
  color:var(--ink3);font-weight:750;padding:13px 15px;border-bottom:2px solid var(--line);
  background:#f5f7fc;position:sticky;top:0;z-index:5}
tbody td{padding:12px 15px;border-bottom:1px solid var(--line2);font-size:13px;
  vertical-align:middle;word-break:break-word}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:#f4f7fe;transition:background .12s}
.mono{font-family:var(--font-mono);font-size:12.5px}
.hn{font-weight:700;color:var(--brand)}
.pill{display:inline-flex;align-items:center;padding:2px 9px;border-radius:6px;
  font-size:11px;font-weight:650;white-space:nowrap;line-height:1.6}
.pill.ok{background:var(--okbg);color:var(--ok)}
.pill.bad{background:var(--badbg);color:var(--bad)}
.pill.warn{background:var(--warnbg);color:var(--warn)}
.pill.na{background:var(--nabg);color:var(--na)}

/* ── score bar in cell ── */
.sc{display:flex;align-items:center;gap:10px;min-width:140px}
.sc .n{font-weight:800;font-size:15px;width:52px;text-align:right;
  flex-shrink:0}
.sc .t{flex:1;height:8px;border-radius:5px;background:var(--nabg);overflow:hidden}
.sc .t i{display:block;height:100%;border-radius:5px}

/* ── footer ── */
footer{margin-top:36px;padding-top:18px;border-top:1px solid var(--line);
  font-size:11.5px;color:var(--ink3);line-height:2}

@media print{
  body{background:#fff}
  .mast{background:#122240 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .st,.tblwrap{box-shadow:none;break-inside:avoid}
  }
</style>
</head>
<body>
<header class="mast">
  <div class="mast-in">
    <div>
      <h1>{{ cis_benchmark_name }} {{ cis_benchmark_version }} · {{ 'Fleet Compliance Overview' }}</h1>
      <div class="sub">{{ hosts | length }} {{ 'hosts' }} · {{ 'profile' }} {{ cis_profile }} ·
         {{ 'mode' }} {{ 'apply' if cis_mode_effective == 'apply' else 'scan' }} ·
         {{ 'generated' }} {{ cis_run_human }}</div>
    </div>
    <div class="mbadges">
    </div>
  </div>
</header>
<div class="wrap">
  <div class="stats">
    <div class="st"><div class="k">{{ 'Fleet Score' }}</div>
      <div class="v" style="color:{{ '#0d7a53' if fleetscore >= 90 else ('#b86c00' if fleetscore >= 70 else '#c42a1e') }}">{{ fleetscore }}<span style="font-size:17px">%</span></div>
      <div class="u">{{ tot['pass'] }} / {{ scored }} {{ 'passed' }}</div></div>
    <div class="st"><div class="k">{{ 'To Fix' }}</div>
      <div class="v" style="color:#c42a1e">{{ tot['fail'] }}</div>
      <div class="u">{{ 'fleet-wide' }}</div></div>
    <div class="st"><div class="k">{{ 'L1 Fixed' }}</div>
      <div class="v" style="color:#1a50ba">{{ tot['l1applied'] }}</div>
      <div class="u">{{ 'Level 1 rules' }}</div></div>
    <div class="st"><div class="k">{{ 'L2 Fixed' }}</div>
      <div class="v" style="color:#7c3aed">{{ tot['l2applied'] }}</div>
      <div class="u">{{ 'Level 2 rules' }}</div></div>
    <div class="st"><div class="k">{{ 'Manual' }}</div>
      <div class="v" style="color:#4a5f7a">{{ tot['manual'] }}</div>
      <div class="u">{{ 'needs review' }}</div></div>
    <div class="st"><div class="k">{{ 'Fix Failed' }}</div>
      <div class="v" style="color:{{ '#c42a1e' if tot['failedfix'] else '#8896aa' }}">{{ tot['failedfix'] }}</div>
      <div class="u">{{ 'needs attention' }}</div></div>
  </div>

  <h2 class="sec">{{ 'Host Details' }}</h2>
  <div class="tblwrap">
    <table>
      <thead>
        <tr>
          <th>{{ 'Host' }}</th><th>IPv4</th><th>MAC</th><th>{{ 'OS' }}</th>
          <th>{{ 'Score' }}</th><th>{{ 'Pass / Fail' }}</th><th>{{ 'L1 Fixed' }}</th><th>{{ 'L2 Fixed' }}</th><th>{{ 'Report' }}</th>
        </tr>
      </thead>
      <tbody>
      {% for hv in hosts %}
      {%- set s = hv.cis_result.summary -%}
      {%- set sc = s.all.score | float -%}
      {%- set col = '#0d7a53' if sc >= 90 else ('#b86c00' if sc >= 70 else '#c42a1e') -%}
        <tr>
          <td class="hn">{{ hv.cis_host.hostname | e }}</td>
          <td class="mono">{{ hv.cis_host.ipv4 | e if hv.cis_host.ipv4 else '—' }}</td>
          <td class="mono" style="word-break:break-all">{{ hv.cis_host.mac | upper | e if hv.cis_host.mac else '—' }}</td>
          <td>{{ hv.cis_host.os | e }}</td>
          <td>
            <div class="sc">
              <span class="n" style="color:{{ col }}">{{ sc }}%</span>
              <span class="t"><i style="background:{{ col }};width:{{ sc }}%"></i></span>
            </div>
          </td>
          <td><span class="pill ok">{{ s.all['pass'] }}</span> /
              <span class="pill {{ 'bad' if (s.all.fail | int) else 'na' }}">{{ s.all.fail }}</span></td>
          <td><span class="pill {{ 'ok' if (s.L1.applied | int) else 'na' }}">{{ s.L1.applied }}</span>
              {%- if s.L1.applied_pending | int %} <span class="pill warn">+{{ 'pending' }}</span>{% endif %}</td>
          <td><span class="pill {{ 'ok' if (s.L2.applied | int) else 'na' }}">{{ s.L2.applied }}</span>
              {%- if s.L2.applied_pending | int %} <span class="pill warn">+{{ 'pending' }}</span>{% endif %}</td>
          <td><a href="{{ hv.cis_report_slug }}.html">{{ 'Open' }} &rsaquo;</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <footer>
    {{ cis_benchmark_name }} {{ cis_benchmark_version }} ·
    {{ hosts | length }} {{ 'hosts' }} · {{ 'rules assessed' }} {{ tot['rules'] }} ·
    {{ 'Engine' }} v{{ hosts[0].cis_result.engine_version if hosts else '-' }} ·
    {{ 'generated' }} {{ cis_run_human }}
  </footer>
</div>
<script>
(function () {
    }
  var saved = '';
  try { saved = localStorage.getItem('cis_lang') || ''; } catch(e) {}
  if (saved) 
  if (btn) { btn.addEventListener('click', function () {
}); }
})();
</script>
</body>
</html>
